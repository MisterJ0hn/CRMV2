{% extends 'base.html.twig' %}

{% block title %}Archivo de Logs{% endblock %}

{% block body %}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-archive mr-2"></i>Archivo de Logs</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Inicio</a></li>
                    <li class="breadcrumb-item active">Archivo de Logs</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">

    <div class="card card-outline card-primary">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-file-csv mr-1"></i> Respaldos mensuales</h3>
            <div class="card-tools">
                <div class="btn-group btn-group-sm" role="group" id="filtroOrigen">
                    <button type="button" class="btn btn-secondary active" data-origen="">Todos</button>
                    {% for clave, origen in origenes %}
                        <button type="button" class="btn btn-secondary" data-origen="{{ clave }}">{{ origen.titulo }}</button>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="card-body">

            <p class="text-muted">
                Registros retirados de la base de datos por los procesos de archivado y guardados en CSV, un archivo por mes.
            </p>

            {% if archivos is empty %}
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle mr-1"></i> Todavía no hay archivos generados.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Origen</th>
                                <th>Período</th>
                                <th>Archivo</th>
                                <th class="text-right">Tamaño</th>
                                <th>Última modificación</th>
                                <th class="text-center" style="width:130px;">Descarga</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for a in archivos %}
                                <tr class="fila-log" data-origen="{{ a.origen }}">
                                    <td>
                                        <span class="badge {{ a.badge }}">
                                            <i class="{{ a.icono }} mr-1"></i>{{ a.titulo }}
                                        </span>
                                    </td>
                                    <td>{{ a.mes }}</td>
                                    <td><code>{{ a.archivo }}</code></td>
                                    <td class="text-right">{{ a.tamano }}</td>
                                    <td>{{ a.modificado|date('d/m/Y H:i') }}</td>
                                    <td class="text-center">
                                        <a href="{{ path('archivo_logs_descargar', {'origen': a.origen, 'archivo': a.archivo}) }}"
                                           class="btn btn-sm btn-success">
                                            <i class="fas fa-download mr-1"></i> CSV
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

        </div>
    </div>

</div>
</section>

<script>
    document.querySelectorAll('#filtroOrigen button').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var origen = this.dataset.origen;

            document.querySelectorAll('#filtroOrigen button').forEach(function (b) {
                b.classList.remove('active');
            });
            this.classList.add('active');

            document.querySelectorAll('.fila-log').forEach(function (fila) {
                fila.style.display = (origen === '' || fila.dataset.origen === origen) ? '' : 'none';
            });
        });
    });
</script>

{% endblock %}
